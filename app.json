{
  "expo": {
    "name": "Jakobs_final",
    "slug": "Jakobs_final",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jakobsfinal",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mawlicious.Jakobs-final",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mawlicious.Jakobsfinal"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-dev-client",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "Allow Jakob's to use your location to accept Tap to Pay payments.",
          "bluetoothPeripheralPermission": "Allow Jakob's to use Bluetooth to accept Tap to Pay payments.",
          "bluetoothAlwaysUsagePermission": "Allow Jakob's to keep Bluetooth access for supported payment readers.",
          "localNetworkUsagePermission": "Allow Jakob's to access the local network for supported payment readers.",
          "tapToPayCheck": true
        }
      ],
      "./plugins/with-tap-to-pay-entitlement"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20f332fe-474b-462b-bc1d-bc4026d172ea"
      }
    }
  }
}
